# Run all scripts from the repository root and set PROJECT_ROOT to that folder.
PROJECT_ROOT=/absolute/path/to/immunonutritional_renal_phenotypes_freeze_v2_v1.0.0

# Public NHANES XPT files, if not placed under data/nhanes.
NHANES_DATA_DIR=/absolute/path/to/nhanes_xpt_files

# Credentialed PhysioNet datasets. Do not place these inside a public repository.
MIMIC_ROOT=/absolute/path/to/mimic-iv-3.1
EICU_DIR=/absolute/path/to/eicu-crd-2.0

# Local clone of MIT-LCP mimic-code tag v3.0.1, concepts_duckdb directory.
MIMIC_CODE_ROOT=/absolute/path/to/mimic-code/mimic-iv/concepts_duckdb

# Optional existing cache of official NHANES 2005-2010 XPT and mortality files.
# If omitted, the historical-transport script uses output/.../official_source_cache.
NHANES_HISTORICAL_CACHE=/absolute/path/to/nhanes_2005_2010_source_cache

# Optional computational controls.
AUTO_INSTALL_R_PACKAGES=false
WRITE_FIGURES=false
CINDEX_BOOTSTRAP_REPS=1000
ABSOLUTE_RISK_BOOTSTRAP_REPS=1000
PIPELINE_STAGE=nhanes
